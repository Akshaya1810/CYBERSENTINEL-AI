# Copy this file to .env and replace CHANGE_ME with your local PostgreSQL password.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/cybersentinel
ENVIRONMENT=development

# Local deterministic detection thresholds (all time windows are in seconds).
SSH_BRUTEFORCE_THRESHOLD=5
SSH_BRUTEFORCE_WINDOW_SECONDS=300
SSH_SUCCESS_FAILURE_THRESHOLD=5
SSH_SUCCESS_FAILURE_WINDOW_SECONDS=600
SSH_INVALID_USER_THRESHOLD=3
SSH_INVALID_USER_WINDOW_SECONDS=300
DETECTION_GROUPING_WINDOW_SECONDS=1800

# Local-only Ollama inference (no cloud AI APIs).
OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=300
