      "description": "Five failed SSH password events from one source within the deterministic rule's default five-minute window.",
      "incident_severity": "High",
      "source_ip": "203.0.113.10",
      "events": [
        {"id": 1101, "event_type": "ssh_authentication_failed", "offset_seconds": 0, "source_ip": "203.0.113.10", "username": "analyst", "hostname": "synthetic-edge-1", "description": "Synthetic failed SSH password authentication."},
        {"id": 1102, "event_type": "ssh_authentication_failed", "offset_seconds": 10, "source_ip": "203.0.113.10", "username": "analyst", "hostname": "synthetic-edge-1", "description": "Synthetic failed SSH password authentication."},
        {"id": 1103, "event_type": "ssh_authentication_failed", "offset_seconds": 20, "source_ip": "203.0.113.10", "username": "analyst", "hostname": "synthetic-edge-1", "description": "Synthetic failed SSH password authentication."},
