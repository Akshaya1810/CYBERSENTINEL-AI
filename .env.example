# Copy to .env for local configuration. Do not put real credentials in this file.
# The default is a local PostgreSQL development URL; PostgreSQL is not required for /api/health.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cybersentinel
ENVIRONMENT=development

# Frontend API origin (Vite reads this when the dev server starts)
VITE_API_URL=http://127.0.0.1:8000
