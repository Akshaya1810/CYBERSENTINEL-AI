        {"probe_id": "intent-is-hypothesis", "text": "The source may be guessing passwords.", "claim_type": "hypothesis", "event_ids": [1101], "expected_status": "unverified"},
        {"probe_id": "unknown-evidence-id", "text": "An unsupported event is cited.", "claim_type": "fact", "event_ids": [1199], "expected_status": "unsupported"}
